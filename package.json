{
  "name": "quoteforge-pro",
  "version": "1.0.0",
  "description": "QuoteForge Pro — self-hostable 3D printing quote calculator with network printer integration (live Bambu Lab status via MQTT is optional).",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "test": "node test/run.js",
    "electron": "electron .",
    "dist": "electron-builder --mac --win",
    "dist:mac": "electron-builder --mac",
    "dist:win": "electron-builder --win"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "3d-printing",
    "quote-calculator",
    "self-hosted",
    "open-source",
    "electron",
    "desktop"
  ],
  "author": "Ovid International Ltd",
  "license": "AGPL-3.0-only",
  "type": "commonjs",
  "optionalDependencies": {
    "mqtt": "^5.15.2"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3",
    "jsdom": "^24.1.3"
  },
  "build": {
    "appId": "com.ovidinternational.quoteforge-pro",
    "productName": "QuoteForge Pro",
    "copyright": "Copyright © 2026 Ovid International Ltd",
    "asar": true,
    "files": [
      "electron/**/*",
      "server.js",
      "printers.js",
      "index.html",
      "styles.css",
      "calculator.js",
      "multi-part-import.js",
      "reports.js",
      "config.json",
      "manifest.json",
      "sw.js",
      "vendor/**/*",
      "icons/**/*",
      "node_modules/**/*",
      "!node_modules/.cache",
      "!node_modules/jsdom/**/*",
      "!**/test/**",
      "!**/.github/**",
      "!**/docs/**",
      "!**/extras/**",
      "!**/google-apps-script/**",
      "!**/*.{bat,command,nsi,md}"
    ],
    "extraMetadata": {
      "main": "electron/main.js"
    },
    "mac": {
      "category": "public.app-category.business",
      "target": [
        { "target": "dmg", "arch": ["x64", "arm64"] },
        { "target": "zip", "arch": ["x64", "arm64"] }
      ],
      "darkModeSupport": true
    },
    "win": {
      "target": [
        { "target": "nsis", "arch": ["x64"] }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "QuoteForge Pro"
    },
    "dmg": {
      "title": "QuoteForge Pro",
      "contents": [
        { "x": 130, "y": 220 },
        { "x": 410, "y": 220, "type": "link", "path": "/Applications" }
      ]
    },
    "publish": {
      "provider": "github",
      "releaseType": "release"
    }
  }
}
